# Supabase (paste from Supabase Dashboard → Database → Connection string)
# Option A: let DatabaseUrlProcessor auto-convert postgres:// -> jdbc:postgresql://?sslmode=require
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.xxxxx
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# JWT (32+ chars, base64)
JWT_SECRET=replace-with-openssl-rand-base64-32

# CORS (frontend URL)
CORS_ALLOWED_ORIGINS=https://sidequest-frontend.onrender.com,http://localhost:3000

# Spring profile
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Frontend
BACKEND_API_URL=https://sidequest-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://sidequest-frontend.onrender.com
